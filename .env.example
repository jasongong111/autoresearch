# Docker Compose — copy to .env at repo root: cp .env.example .env
# Compose loads this file automatically for ${VAR} substitution.

# Backend port (host)
DASHBOARD_PORT=3847

# Frontend nginx port (host)
FRONTEND_PORT=3000

# Host directory mounted as /workspace in the backend container
DASHBOARD_WORKSPACE=.

# Cursor SDK — required for orchestrator runner=cursor and ./bin/autoresearch-cursor in Docker
# Get a key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional Cursor model (default: composer-2.5)
# CURSOR_MODEL=composer-2.5

# Cursor agent transcripts for the Conversation tab (host absolute path)
# CURSOR_TRANSCRIPTS_DIR=~/.cursor/projects/Users-you-Desktop-autoresearch/agent-transcripts

# Agent Core (skill agent) port
AGENT_CORE_PORT=8766

# Optional: hosted Gemma API keys (research tasks)
# GEMMA3_API_KEY=
GEMMA4_API_KEY=
