#!/usr/bin/env bash
# Run autoresearch via the Cursor SDK (local agent).
#
# Usage:
#   export CURSOR_API_KEY="cursor_..."
#   ./bin/autoresearch-cursor --project tasks/gemma4-math-skill-optimization \
#     --goal "Improve Gemma 4 math score" \
#     --scope "skills/**" \
#     --metric "accuracy" \
#     --verify "./tests/verify-metric.sh" \
#     --iterations 5
#
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${ROOT}:${PYTHONPATH:-}"

ENV_NAME="autoresearch-dashboard"
MAIN_ARGS=(-m backend.scripts.run_autoresearch_cursor "$@")

if [[ "${CONDA_DEFAULT_ENV:-}" == "${ENV_NAME}" ]] && command -v python >/dev/null 2>&1; then
  exec python "${MAIN_ARGS[@]}"
fi

if command -v conda >/dev/null 2>&1; then
  if conda env list 2>/dev/null | awk '{print $1}' | grep -qx "${ENV_NAME}"; then
    exec conda run --no-capture-output -n "${ENV_NAME}" \
      env PYTHONPATH="${PYTHONPATH}" \
      python "${MAIN_ARGS[@]}"
  fi
fi

PYTHON=""
for candidate in python3.12 python3.11 python3; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PYTHON="$candidate"
    break
  fi
done

if [[ -z "${PYTHON}" ]]; then
  echo "Error: no Python found." >&2
  exit 1
fi

exec "${PYTHON}" "${MAIN_ARGS[@]}"
