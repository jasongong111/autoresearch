# Copy to dashboard/.env or export before: docker compose -f dashboard/docker-compose.yml up
DASHBOARD_PORT=3847
# Host path mounted as /workspace inside the container (repo root recommended)
DASHBOARD_WORKSPACE=..
# Cursor agent transcripts for live conversation tab (host absolute path)
CURSOR_TRANSCRIPTS_DIR=~/.cursor/projects/Users-jasongong-Desktop-autoresearch/agent-transcripts
